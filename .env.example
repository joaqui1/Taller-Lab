SITE_URL=https://www.tallerlab.com.ar
# Alertas: almacén compartido persistente (puede usar DATABASE_URL si es la misma base).
ALERTAS_DATABASE_URL=
# Clave distinta de CRON_SECRET para la mesa editorial. Nunca incluir en URLs.
ALERTAS_EDITOR_TOKEN=
ALERTAS_RUN_BUDGET_SECONDS=210
# Sólo QA/local: SQLite persistente para probar la misma operación.
# ALERTAS_STATE_PATH=tmp/alertas-qa.sqlite3
# Compatibilidad: PostgreSQL persistente en producción. También reconoce DATABASE_URL
# o ALERTAS_DATABASE_DATABASE_URL de la integración Neon existente; usa tablas propias.
COMPATIBILITY_DATABASE_URL=
# Vercel envía CRON_SECRET en Authorization. POST manual usa el mismo secreto.
CRON_SECRET=
COMPATIBILITY_MAINTENANCE_TOKEN=
# Ruta SQLite opcional para desarrollo; nunca se usa como persistencia en Vercel.
COMPATIBILITY_STATE_PATH=
# Correo público de contacto; si queda vacío se usa el canal de correcciones de GitHub.
CONTACT_EMAIL=

# Observatorio de precios (Producción)
# Cadena de conexión PostgreSQL administrado (ej: postgresql://user:pass@host:5432/dbname?sslmode=require)
# Si queda vacío en local, utiliza automáticamente SQLite (observatorio.db).
DATABASE_URL=

# Secreto para autorizar el cron de recolección de Vercel y endpoints de administración
OBSERVATORY_SECRET=
# CRON_SECRET se define arriba y se comparte entre los cron de Vercel.

# Límite de ofertas a procesar por ejecución serverless (para respetar límites de duración)
OBSERVATORY_MAX_BATCH_SIZE=50
OBSERVATORY_RUN_BUDGET_SECONDS=240

# Relevamiento: cerrado por defecto. Abrir únicamente tras verificar persistencia.
RELEVAMIENTO_HABILITADO=0
RELEVAMIENTO_ADMIN_KEY=
# Secreto aleatorio estable (al menos 32 caracteres), distinto de la clave de acceso.
RELEVAMIENTO_SESSION_SECRET=
# PostgreSQL persistente, obligatorio en producción. SQLite se usa solo en local.
RELEVAMIENTO_DATABASE_URL=

# Comunidad: SQLite solo local. Abrir producción después de probar la base real.
COMUNIDAD_HABILITADA=0
COMUNIDAD_DATABASE_URL=
COMUNIDAD_ADMIN_KEY=
# Secreto estable de al menos 32 caracteres; también firma las sesiones del relevamiento.
COMUNIDAD_SESSION_SECRET=
# Comunidad: avisos opcionales (todo funciona sin ellos).
# Telegram: aviso inmediato de cada aporte nuevo y resumen diario al editor.
COMUNIDAD_TELEGRAM_BOT_TOKEN=
COMUNIDAD_TELEGRAM_CHAT_ID=
# Correo vía Resend: aviso único a quien pregunta y resumen diario. Remitente de un dominio verificado.
RESEND_API_KEY=
COMUNIDAD_AVISOS_REMITENTE=TallerLab <avisos@tallerlab.com.ar>
COMUNIDAD_AVISO_EDITOR_EMAIL=
# Vercel Web Analytics (activar también en el panel del proyecto).
VERCEL_WEB_ANALYTICS=0
