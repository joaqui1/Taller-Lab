{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.tallerlab.com.ar/schemas/fichas_editorial.schema.json",
  "title": "Fichas editoriales de productos",
  "type": "object",
  "required": [
    "version",
    "fecha_investigacion",
    "investigacion_keywords",
    "fuentes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fecha_investigacion": {
      "type": "string",
      "format": "date"
    },
    "investigacion_keywords": {
      "type": "object"
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "titulo",
          "url",
          "tipo",
          "consultado"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "ficha_fabricante",
              "manual_oficial",
              "catalogo_oficial"
            ]
          },
          "consultado": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^(BAT|CHG|TOOL|ADP)-[A-Z0-9-]+$": {
      "type": "object",
      "required": [
        "publicado",
        "last_approved_modified_at"
      ],
      "properties": {
        "publicado": {
          "type": "boolean",
          "default": false,
          "description": "El render editorial permanece desactivado hasta que el dueño lo active explícitamente."
        },
        "last_approved_modified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Fecha ISO de la última modificación aprobada; null mientras siga en borrador."
        },
        "compatibility": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "counterpart_id",
              "type"
            ],
            "properties": {
              "counterpart_id": {
                "type": "string"
              },
              "type": {
                "$ref": "#/$defs/fact"
              },
              "conditions": {
                "$ref": "#/$defs/fact"
              }
            },
            "additionalProperties": false
          }
        },
        "specifications": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fact"
          }
        },
        "charge_times": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "counterpart_id",
              "time"
            ],
            "properties": {
              "counterpart_id": {
                "type": "string"
              },
              "charger_id": {
                "type": "string"
              },
              "label": {
                "$ref": "#/$defs/fact"
              },
              "time": {
                "$ref": "#/$defs/fact"
              }
            },
            "additionalProperties": false
          }
        },
        "tool": {
          "type": "object",
          "properties": {
            "package_note": {
              "$ref": "#/$defs/fact"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "package_type"
                ],
                "properties": {
                  "code": {
                    "$ref": "#/$defs/fact"
                  },
                  "package_type": {
                    "$ref": "#/$defs/fact"
                  },
                  "box_contents": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/fact"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "identification": {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/fact"
            },
            "image": {
              "$ref": "#/$defs/image"
            }
          },
          "additionalProperties": false
        },
        "common_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "faqs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "$ref": "#/$defs/fact"
              },
              "answer": {
                "$ref": "#/$defs/fact"
              }
            },
            "additionalProperties": false
          }
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "research": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "product_type": {
              "type": "string"
            },
            "identity_documented": {
              "type": "boolean"
            },
            "indexable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "classification": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": "string"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "search_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "documentary_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "weight_note": {
              "type": "string"
            },
            "unreported_charge_times": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "publicado": {
                "const": true
              }
            },
            "required": [
              "publicado"
            ]
          },
          "then": {
            "properties": {
              "last_approved_modified_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "source",
        "section",
        "date_consulted",
        "excerpt"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "V",
            "Ah",
            "Wh",
            "kg",
            "g",
            "mm",
            "cm",
            "min",
            "h",
            "W",
            "rpm",
            "A",
            "Hz",
            "bar",
            "ml",
            "ml/min",
            "DIN/s",
            "dB(A)",
            "m/s2",
            "Nm",
            "bpm",
            "lb",
            "tipo de relación",
            "condición",
            "presentación",
            "elemento",
            "texto",
            "pregunta",
            "respuesta",
            "archivo",
            "texto alternativo",
            "autor o licencia",
            "crédito visible"
          ]
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "date_consulted": {
          "type": "string",
          "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "Extracto de hasta 25 palabras."
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "value_format": {
          "type": "string",
          "enum": [
            "range",
            "ranges",
            "dimensions",
            "list"
          ]
        },
        "source_excerpt_note": {
          "type": "string",
          "minLength": 1
        },
        "supporting_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "section",
              "date_consulted",
              "excerpt"
            ],
            "properties": {
              "source": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "date_consulted": {
                "type": "string",
                "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "V",
                  "Ah",
                  "Wh",
                  "kg",
                  "g",
                  "mm",
                  "cm",
                  "min",
                  "h",
                  "W",
                  "rpm",
                  "A",
                  "Hz",
                  "bar",
                  "ml",
                  "ml/min",
                  "DIN/s",
                  "dB(A)",
                  "m/s2",
                  "Nm",
                  "bpm",
                  "lb"
                ]
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "array"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "required": [
              "value_format"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_format": {
                "const": "dimensions"
              }
            },
            "required": [
              "value_format"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_format": {
                "const": "range"
              }
            },
            "required": [
              "value_format"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_format": {
                "const": "ranges"
              }
            },
            "required": [
              "value_format"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "file",
        "alt",
        "author_or_license",
        "credit"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/fact"
        },
        "alt": {
          "$ref": "#/$defs/fact"
        },
        "author_or_license": {
          "$ref": "#/$defs/fact"
        },
        "credit": {
          "$ref": "#/$defs/fact"
        }
      },
      "additionalProperties": false
    }
  }
}
